# Force LF line endings for shell scripts. Without this, a Windows clone
# with core.autocrlf=true would convert the docker-entrypoint.sh shebang
# to "#!/bin/sh\r", and any local `docker compose build` would bake the
# CRLFs into the image. The resulting container fails to start with
# "exec /docker-entrypoint.sh: no such file or directory" — the kernel is
# actually failing to find an interpreter called "/bin/sh\r", but the
# error message blames the script.
*.sh            text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile      text eol=lf

# Generated by `npm run openapi:export`; byte-stable output is compared in
# CI, so keep it LF on every platform.
openapi.json    text eol=lf

# Git hooks run under sh on every platform.
.husky/*        text eol=lf

# The web Dockerfile hashes the inline <script> blocks of index.html and
# compares them with the CSP sha256 list in nginx/security-headers.conf. A
# Windows clone with core.autocrlf=true checks index.html out with CRLF, the
# hashes change, and `docker compose build web` fails the CSP guard. Keep
# it LF everywhere so a local build matches CI.
packages/web/index.html text eol=lf
