    "overapply": "payment > cent balance is OVERAPPLIED, compared exactly, no tolerance (Q-P21g)",
    "auto": "no applications: the amount fills open invoices oldest first (txnDate, number, id), each up to its cent balance",
    "explicit": "rows sent: typed amounts as typed; amount null fills what is left of the payment in date order; rows not sent 0.00; no payment amount: fill rows take their cent balance and amount is the sum (from_applications)",
    "unapplied": "amount - applied; stays an A/R credit on the client",
    "shortfalls": "invoices this payment pays in part: cent balance - payment"
  },
