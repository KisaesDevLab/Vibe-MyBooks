          { "itemType": "non_inventory", "quantity": "6", "unitPrice": "48.00", "unitPriceSource": "item", "discountPercent": null, "amount": "288.00", "taxRate": "0.0810", "taxAmount": "23.33" },
          { "itemType": "discount", "quantity": null, "unitPrice": null, "unitPriceSource": "item", "discountPercent": "10.0000", "amount": "-106.80", "taxRate": "0.0810", "taxAmount": "-8.65" }
