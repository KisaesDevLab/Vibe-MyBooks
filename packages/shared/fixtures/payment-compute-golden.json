{
  "rules": {
    "centBalance": "round2(stored balance_due), half away from zero; a legacy sub-cent residue is never shown or posted (Q-P21t)",
    "amounts": "decimal strings, at most 2 places; more is 400 VALIDATION_ERROR",
    "overapply": "payment > cent balance is OVERAPPLIED, compared exactly, no tolerance (Q-P21g)",
    "auto": "no applications: the amount fills open invoices oldest first (txnDate, number, id), each up to its cent balance",
    "explicit": "rows sent: typed amounts as typed; amount null fills what is left of the payment in date order; rows not sent 0.00; no payment amount: fill rows take their cent balance and amount is the sum (from_applications)",
    "unapplied": "amount - applied; stays an A/R credit on the client",
    "shortfalls": "invoices this payment pays in part: cent balance - payment",
    "order": "per invoice: typed cash, discount and write-off first; then credits (typed, then fill); then cash fill / auto",
    "discount": "discountAvailable = round2(total x discountPercent / 100) half away from zero, capped at the cent balance, on or before discountDate, once per invoice; suggestDiscount when none typed and payment = cent balance - discountAvailable exactly",
    "writeOff": "shortfalls[].withinWriteOffLimit = shortfall <= the company writeOffThreshold (false without one)"
  },
